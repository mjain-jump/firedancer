# logfile_fd: It can be disabled by configuration, but typically tiles
#             will open a log file on boot and write all messages there.
#
# accounts_fd: The file descriptor for the accounts database.  Execution
#              tiles may need to pull accounts into the cache from disk,
#              or purge out of cache to the disk to make forward
#              progress.
uint logfile_fd, uint accounts_fd, uint snapshot_fd

# logging: all log messages are written to a file and/or pipe
#
# 'WARNING' and above are written to the STDERR pipe, while all messages
# are always written to the log file.
#
# arg 0 is the file descriptor to write to.  The boot process ensures
# that descriptor 2 is always STDERR.
write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

# logging: 'WARNING' and above fsync the logfile to disk immediately
#
# arg 0 is the file descriptor to fsync.
fsync: (eq (arg 0) logfile_fd)

# shutdown: exit is called on shutdown
exit: (eq (arg 0) 0)

# accounts database: allocate more space from the disk
#
# The accounts database allocates more space from the underlying storage
# device in chunks, as it runs out.
fallocate: (and (eq (arg 0) accounts_fd)
                (eq (arg 1) 0))

# accounts database: write account records at explicit offsets
#
# Parallel snapshot loader tiles write the packed account records
# directly into their own partitions of the accounts file.
#
# Only used by FD_SNAPIN_WRITE_MODE=0; the default engine maps the
# partition instead (see below).
#
# arg 0 is the file descriptor to write to.
pwrite64: (eq (arg 0) accounts_fd)

# accounts database: map the tile's own partition to write records into
#
# The default snapshot write engine stores its packed account records
# into an mmap of the accdb partition its private write head is in,
# instead of pwrite()ing them: N tiles pwriting one inode serialize on
# the filesystem's exclusive per-inode write lock even though their
# byte ranges are disjoint, while write faults on a shared mapping take
# it shared.  One mapping at a time per tile, remapped when the write
# head rotates to a fresh partition.
#
# arg 4 is the file descriptor being mapped, arg 2 the protection and
# arg 3 the flags: nothing else in this tile calls mmap after the
# sandbox is installed, so the accounts file is the only mappable
# object and the mapping must be exactly a shared read-write one.
mmap: (and (eq (arg 4) accounts_fd)
           (and (eq (arg 2) "PROT_READ|PROT_WRITE")
                (eq (arg 3) "MAP_SHARED")))

# accounts database: drop the mapping of a partition the write head
# rotated away from, and at the end of the load
#
# munmap takes no file descriptor, so there is nothing to restrict it
# to; it can only ever affect the calling process's own address space,
# and the tile only unmaps what it mapped above.
munmap

# accounts database: take the mapping's write faults in batches
#
# MADV_POPULATE_WRITE faults in a run of the mapping in one kernel
# loop instead of one trap per 4 KiB page.  Only reachable when
# FD_SNAPIN_MMW_PREFAULT_MB is set.
#
# arg 2 is the advice.
madvise: (eq (arg 2) "MADV_POPULATE_WRITE")

# accounts database: tile 0 samples records back from the
# accounts file at load end to verify the index and file agree.
#
# The readback reads each sampled record whole (header plus compressed
# payload) and decompresses it, so it goes through the shared
# accdb_read_record helper, which issues preadv2(2) and not pread(2).
# Any accdb entry point reachable from this tile must keep to the four
# syscalls named in this policy; adding a read path that uses a
# different one silently turns into SIGSYS under the full sandbox,
# because only the unsandboxed snapshot-load harness exercises it.
#
# arg 0 is the file descriptor to read from.
preadv2: (eq (arg 0) accounts_fd)

# accounts database: start and bound asynchronous writeback
#
# Parallel snapshot loader tiles kick kernel writeback of their
# written records in large contiguous runs, and wait on the oldest
# in-flight range to bound dirty page accumulation.
#
# arg 0 is the file descriptor being written back.
sync_file_range: (eq (arg 0) accounts_fd)

# snapshot archive: the fused file-partitioned loader reads its own
# compressed byte range of the snapshot straight off the device.
#
# Each snapin tile holds its own read-only fd on the archive and preads
# from it; nothing else in the tile issues pread64.
#
# arg 0 is the file descriptor to read from.
pread64: (eq (arg 0) snapshot_fd)

# snapshot archive: declare the tile's own byte range sequential
#
# Each tile announces its exclusive [lo,hi) of the archive as
# POSIX_FADV_SEQUENTIAL once, when the range is resolved, so the kernel
# reads ahead across it instead of treating the N interleaved streams as
# random access.
#
# arg 0 is the file descriptor and arg 3 the advice.
fadvise64: (and (eq (arg 0) snapshot_fd)
                (eq (arg 3) "POSIX_FADV_SEQUENTIAL"))
